TZ=UTC
PUID=1000
PGID=1000
CONFIG_ROOT=./config
DATA_ROOT=./data

# VPN / Gluetun
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=replace-me
WIREGUARD_ADDRESSES=replace-me
VPN_SERVER_COUNTRIES=
QBIT_WEBUI_PORT=8080
TORRENT_PORT=6881

# App ports
PROWLARR_PORT=9696
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
BAZARR_PORT=6767
JELLYFIN_PORT=8096
JELLYSEERR_PORT=5055
FLARESOLVERR_PORT=8191

# Optional API keys used by Unpackerr after you generate them in each app.
SONARR_API_KEY=replace-me
RADARR_API_KEY=replace-me
LIDARR_API_KEY=replace-me
